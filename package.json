{
  "name": "sharetab",
  "version": "0.8.0",
  "description": "BillOK — ручное разделение общих чеков и расходов без OCR и AI",
  "author": "Carlos Cristobal",
  "license": "MIT",
  "homepage": "https://github.com/sw-carlos-cristobal/sharetab",
  "repository": {
    "type": "git",
    "url": "https://github.com/sw-carlos-cristobal/sharetab.git"
  },
  "keywords": [
    "self-hosted",
    "splitwise-alternative",
    "expense-tracker",
    "nextjs",
    "docker",
    "unraid"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:full": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pr:create": "node scripts/pr-create.mjs",
    "git:push-main": "node scripts/git-push-main.mjs",
    "push:main": "npm run git:push-main --",
    "db:seed": "npx tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:docker": "bash scripts/docker-smoke.sh --build",
    "test:e2e:ui": "npx playwright test --ui",
    "demo": "tsx e2e/demo-video.ts",
    "demo:gifs": "tsx e2e/demo-gifs.ts",
    "lint:i18n": "npx tsx scripts/check-translations.ts",
    "test:coverage": "vitest run --coverage",
    "sbp:sync": "node scripts/sync-sbp-banks.mjs",
    "sbp:sync:test": "node --test scripts/lib/sbp-catalog-sync.test.mjs && node --test scripts/lib/sbp-auto-publish-gate.test.mjs && node --test scripts/lib/sbp-auto-publish-evidence.test.mjs && node --test scripts/lib/sbp-auto-publish-merge.test.mjs && node --test scripts/lib/sbp-auto-publish-merge-runner.test.mjs && node --test scripts/lib/sbp-catalog-deploy-readiness.test.mjs && node --test scripts/lib/sbp-catalog-failure-email.test.mjs && node --test scripts/lib/sbp-catalog-rollback-plan.test.mjs && node --test scripts/lib/sbp-catalog-deploy-runner.test.mjs && bash scripts/ops/sbp-catalog-trust.test.sh && bash scripts/ops/sbp-catalog-poll.test.sh"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "overrides": {
    "@hono/node-server": ">=1.19.13",
    "hono": ">=4.12.21",
    "postcss": ">=8.5.10",
    "fast-uri": ">=3.1.1"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.104.3",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.58.0",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "embedded-postgres": "^18.3.0-beta.16",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
