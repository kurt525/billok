# ─── Database ───────────────────────────────────────────────
# For local dev with embedded-postgres (npm run dev:full):
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/sharetab"
# For Docker (constructed from DB_USER/DB_PASSWORD/DB_NAME if not set):
# DATABASE_URL="postgresql://sharetab:sharetab@localhost:5432/sharetab"
DB_USER="sharetab"
DB_PASSWORD="sharetab"
DB_NAME="sharetab"

# ─── NextAuth ───────────────────────────────────────────────
# Public URL of your instance. Split and personal links are copied from the
# browser address bar, not built from this, so share them from this URL.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST=true

# ─── Mail for registration confirmation and Passkey recovery ONLY ───
# SMTP NEVER authorizes a login. The BillOK Auth.js provider list must not
# include Nodemailer/Magic Link, Google or OIDC, regardless of environment.
# Confirmation requires encrypted SMTP, noreply@billok.ru and a trusted URL.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="BillOK <noreply@billok.ru>"

# ─── Rate Limiting ──────────────────────────────────────────
# NOTE: per-IP limits derive the client IP from proxy headers
# (cf-connecting-ip, then x-real-ip, then x-forwarded-for). These are spoofable
# unless a trusted reverse proxy sets them from the connection — front the
# app with one in production. Per-account and global caps apply regardless.
# Max login attempts per email per 15 minutes (increase for testing/CI)
# Max login attempts per client IP per 15 minutes (bounds password spraying)
# Max registrations per IP per hour
REGISTER_RATE_LIMIT_MAX="10"
# Short anti-spam burst per signed-in account per minute, shared by both
# receipt creation methods; NOT a cap on receipts per hour/day or per IP.
GUEST_RATE_LIMIT_MAX="60"
# Global hourly caps across ALL guests combined — bounds unauthenticated disk
# usage and AI spend even if per-IP limits are bypassed via spoofed headers
# To stop anonymous receipt uploads and AI scans entirely, turn off
# "Guest Receipt Uploads" in the admin dashboard, or set this to "true" to lock
# them off regardless of the admin toggle. Signed-in users with an active account
# keep access, so also limit who can create one: Registration Control covers
# password and Google sign-up; magic link and OIDC auto-registration still create accounts

# ─── Admin ──────────────────────────────────────────────────
# Email of the admin user (grants access to /admin dashboard)
ADMIN_EMAIL=""
# First owner bootstrap must be performed MANUALLY in a local TTY on an empty DB.
# Never store the acknowledgement persistently in env files.
# BILLOK_OWNER_BOOTSTRAP_ACK=CREATE_INITIAL_OWNER npx tsx scripts/bootstrap-owner.ts --create
# For one pending owner, at most three email attempts:
# BILLOK_OWNER_BOOTSTRAP_ACK=CREATE_INITIAL_OWNER npx tsx scripts/bootstrap-owner.ts --resend
# Production WebAuthn RP origin must match NEXTAUTH_URL=https://billok.ru.
# BILLOK_WEBAUTHN_RP_ID="billok.ru"
# BILLOK_WEBAUTHN_ORIGIN="https://billok.ru"


# ─── Logging ────────────────────────────────────────────────
# "debug" | "info" | "warn" | "error" (default: "info" in production, "debug" in dev)
LOG_LEVEL="info"

# BillOK 5.12: OPTIONAL Web Push for PWA/Android TWA.
# Leave both keys empty until the site is accepted and configured for HTTPS.
# Generate a matching VAPID pair securely with the web-push CLI; keep the
# private key only in deployment secrets, never in Git.
# Without keys no permission is requested: saved BillOK inbox remains active.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:noreply@billok.ru
