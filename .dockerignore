# dependencies & build output (regenerated in-image)
node_modules
.next
src/generated
*.tsbuildinfo

# vcs & tooling
.git
.github
.claude
.mcp.json
.playwright-mcp
workspace.code-workspace

# 8.11: no local credentials, package auth tokens or private keys in image.
# Applies to nested files as well as repo-root files.
.env*
**/.env*
.npmrc
**/.npmrc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/secrets/

# runtime data (dev only — never ship into the image)
data
.pgdata
uploads

# tests & their fixtures (not needed for a production build)
e2e
test-results
playwright-report
blob-report
coverage
tmp-screenshots
test-screenshots

# docs, demo media & deprecated OCR data (not used at build time)
docs
demo
eng.traineddata
*.md
!README.md
